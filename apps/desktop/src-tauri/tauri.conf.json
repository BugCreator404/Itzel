{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Itzel",
  "version": "0.1.0",
  "identifier": "mx.itzel.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Itzel",
        "width": 900,
        "height": 650,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": true
      },
      {
        "label": "chat",
        "title": "",
        "width": 380,
        "height": 500,
        "minWidth": 320,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "transparent": true,
        "shadow": true,
        "skipTaskbar": true,
        "focus": false,
        "windowEffects": {
          "effects": ["mica", "contentBackground"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' http://localhost:7432 ws://localhost:7432"
    },
    "trayIcon": {
      "iconPath": "icons/icon-32.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2025 Edwin Yair Hernández Limón · MIT License",
    "category": "Productivity",
    "shortDescription": "Tu IA personal local y open source",
    "longDescription": "Itzel es una IA personal que corre completamente en tu máquina. Sin internet, sin suscripciones, sin telemetría. Con voz, shortcuts globales, mascota ajolote y CLI completo.",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "notification": {
      "all": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/BugCreator404/itzel/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_TAURI_SIGNER_PUBKEY"
    }
  }
}
