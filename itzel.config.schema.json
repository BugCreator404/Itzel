{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/BugCreator404/itzel/blob/main/itzel.config.schema.json",
  "title": "ItzelConfig",
  "description": "Esquema de configuración de Itzel v0.1.0",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "language": {
      "type": "string",
      "enum": ["es-MX", "en-US"],
      "default": "es-MX"
    },
    "model": {
      "type": "object",
      "properties": {
        "active": { "type": "string", "default": "itzel-1b" },
        "context_length": { "type": "integer", "minimum": 512, "default": 32768 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.7 },
        "top_p": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.95 },
        "max_tokens": { "type": "integer", "minimum": 1, "default": 2048 }
      }
    },
    "voice": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "stt_model": {
          "type": "string",
          "enum": ["whisper-tiny", "whisper-small", "whisper-medium", "whisper-large"],
          "default": "whisper-small"
        },
        "tts_model": { "type": "string", "default": "kokoro" },
        "language": { "type": "string", "default": "es-MX" }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "sandbox_enabled": { "type": "boolean", "default": true },
        "sandbox_cpu_limit": { "type": "number", "minimum": 0.1, "maximum": 1.0, "default": 0.5 },
        "sandbox_ram_mb": { "type": "integer", "minimum": 64, "maximum": 8192, "default": 512 },
        "sandbox_timeout_s": { "type": "integer", "minimum": 5, "maximum": 300, "default": 30 },
        "confirm_irreversible": { "type": "boolean", "default": true }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "host": { "type": "string", "default": "127.0.0.1" },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535, "default": 7432 },
        "dashboard_port": { "type": "integer", "minimum": 1024, "maximum": 65535, "default": 7433 },
        "workers": { "type": "integer", "minimum": 1, "maximum": 8, "default": 1 }
      }
    },
    "rate_limit": {
      "type": "object",
      "properties": {
        "model_rps": { "type": "integer", "minimum": 1, "default": 10 },
        "voice_rps": { "type": "integer", "minimum": 1, "default": 5 },
        "web_rps": { "type": "integer", "minimum": 1, "default": 2 }
      }
    },
    "db": {
      "type": "object",
      "properties": {
        "path": { "type": ["string", "null"], "default": null },
        "wal": { "type": "boolean", "default": true },
        "backup_dir": { "type": "string", "default": "data/backups" },
        "backup_weekly": { "type": "boolean", "default": true }
      }
    },
    "cache": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "l1_max": { "type": "integer", "minimum": 1, "default": 100 },
        "l2_ttl_s": { "type": "integer", "minimum": 60, "default": 86400 },
        "summary_threshold_tokens": { "type": "integer", "minimum": 256, "default": 4000 }
      }
    },
    "skills": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "autoload": { "type": "boolean", "default": true },
        "disabled": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Nombres de skills bloqueadas (no se cargan)."
        }
      }
    },
    "mcp_servers": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "transport": { "type": "string", "enum": ["sse", "stdio"], "default": "sse" },
          "url": { "type": ["string", "null"], "description": "Requerido si transport=sse." },
          "command": { "type": ["string", "null"], "description": "Requerido si transport=stdio." },
          "args": { "type": "array", "items": { "type": "string" }, "default": [] },
          "auth": {
            "type": "string",
            "enum": ["none", "api_key"],
            "default": "none",
            "description": "La API key vive en el keychain del OS (itzel/mcp-<name>), nunca en este archivo."
          },
          "enabled": { "type": "boolean", "default": true }
        },
        "required": ["name"]
      }
    },
    "shortcuts": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "telemetry": {
      "type": "boolean",
      "const": false,
      "description": "SIEMPRE false — principio no negociable de Itzel."
    },
    "analytics": {
      "type": "boolean",
      "const": false,
      "description": "SIEMPRE false — principio no negociable de Itzel."
    }
  },
  "required": ["version", "language"]
}
